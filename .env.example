# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL on k8s — exposed via MetalLB LoadBalancer
# Get the EXTERNAL-IP from: kubectl get svc postgres-lb -n postgres
PHOTO_AI_DATABASE_URL=postgresql://photoai:CHANGEME@192.168.1.XXX:5432/photoai

# Qdrant on k8s — exposed via MetalLB LoadBalancer
# Get the EXTERNAL-IP from: kubectl get svc qdrant-lb -n photo-ai
PHOTO_AI_QDRANT_URL=http://192.168.1.XXX:6333

# Shared secret between runner and Discord bot (generate with: openssl rand -hex 32)
PHOTO_AI_RUNNER_AUTH_TOKEN=CHANGEME

# "fast" = Florence-2 only (~2s/photo) | "full" = Florence-2 + Qwen2.5-VL (~5s/photo)
PHOTO_AI_QUALITY_TIER=fast

# Immich integration — generate key in Immich UI -> Account Settings -> API Keys
PHOTO_AI_IMMICH_URL=https://immich.arffornia.com
PHOTO_AI_IMMICH_API_KEY=CHANGEME
